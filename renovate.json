{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "TimescaleDB release pinned in the Dockerfile and README example",
      "managerFilePatterns": [
        "/^images/timescaledb/Dockerfile$/",
        "/^images/timescaledb/README\\.md$/"
      ],
      "matchStrings": [
        "ARG TSDB_VERSION=(?<currentValue>\\S+)",
        "reference: ghcr\\.io/inomotech-foss/timescaledb-cnpg:(?<currentValue>\\S+)-pg[0-9]+"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "timescale/timescaledb"
    },
    {
      "customType": "regex",
      "description": "Base images pinned in Dockerfiles and runtime tests",
      "managerFilePatterns": [
        "/^images/timescaledb/Dockerfile$/",
        "/^images/timescaledb-toolkit/Dockerfile$/",
        "/^images/openbao-tpm/Dockerfile$/",
        "/^tests/openbao-tpm/run\\.sh$/"
      ],
      "matchStrings": [
        "(?:ARG BASE_IMAGE|image)=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "TimescaleDB Toolkit extension version pinned in images/timescaledb-toolkit/Dockerfile. GitHub tags may add +pN, which is absent from Debian package contents. TOOLKIT_MIN_VERSION is raised by hand.",
      "managerFilePatterns": [
        "/^images/timescaledb-toolkit/Dockerfile$/",
        "/^images/timescaledb/README\\.md$/"
      ],
      "matchStrings": [
        "ARG TOOLKIT_VERSION=(?<currentValue>\\S+)",
        "reference: ghcr\\.io/inomotech-foss/timescaledb-cnpg/toolkit:(?<currentValue>\\S+)-pg[0-9]+"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "timescale/timescaledb-toolkit",
      "extractVersionTemplate": "^v?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)(?:\\+p[0-9]+)?$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/openbao-tpm/Dockerfile$/", "/^tests/openbao-tpm/Dockerfile$/"],
      "matchStrings": [
        "ARG PKCS11_VERSION=(?<currentValue>\\S+)\\s+ARG PKCS11_SHA256=(?<currentDigest>[a-f0-9]+)",
        "tpm2-pkcs11-tools-(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "tpm2-software/tpm2-pkcs11",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/openbao-tpm/Dockerfile$/"],
      "matchStrings": ["ARG TSS_VERSION=(?<currentValue>\\S+)\\s+ARG TSS_SHA256=(?<currentDigest>[a-f0-9]+)"],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "tpm2-software/tpm2-tss",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/openbao-tpm/Dockerfile$/"],
      "matchStrings": ["ARG KMS_VERSION=(?<currentValue>\\S+)\\s+ARG KMS_SHA256=(?<currentDigest>[a-f0-9]+)"],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "openbao/openbao-plugins",
      "versioningTemplate": "regex:^kms-pkcs11-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "The base image tag encodes the PostgreSQL major, which PG_MAJOR must match, so major bumps are a deliberate change.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "The TPM libraries target UBI 10's glibc ABI; review new UBI majors explicitly.",
      "matchPackageNames": ["registry.access.redhat.com/ubi10/ubi"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
