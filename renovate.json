{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "TimescaleDB release pinned in the Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG TSDB_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "timescale/timescaledb"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG base image pinned in the Dockerfiles",
      "managerFilePatterns": ["/^Dockerfile$/", "/^toolkit\\.Dockerfile$/"],
      "matchStrings": [
        "ARG BASE_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Newest TimescaleDB Toolkit release in the list pinned in toolkit.Dockerfile. Older entries stay for non-disruptive upgrades and are pruned by hand.",
      "managerFilePatterns": ["/^toolkit\\.Dockerfile$/"],
      "matchStrings": [
        "ARG TOOLKIT_VERSIONS=\"(?:[^\"]*\\s)?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "timescale/timescaledb-toolkit"
    }
  ],
  "packageRules": [
    {
      "description": "The base image tag encodes the PostgreSQL major, which PG_MAJOR must match, so major bumps are a deliberate change.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
