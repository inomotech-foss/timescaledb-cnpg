{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "TimescaleDB release pinned in the Dockerfile and README example",
      "managerFilePatterns": ["/^Dockerfile$/", "/^README\\.md$/"],
      "matchStrings": [
        "ARG TSDB_VERSION=(?<currentValue>\\S+)",
        "reference: ghcr\\.io/inomotech-foss/timescaledb-cnpg:(?<currentValue>\\S+)-pg[0-9]+"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "timescale/timescaledb"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG base image pinned in the Dockerfiles",
      "managerFilePatterns": ["/^Dockerfile$/", "/^toolkit\\.Dockerfile$/"],
      "matchStrings": [
        "ARG BASE_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "TimescaleDB Toolkit extension version pinned in toolkit.Dockerfile. GitHub tags may add +pN, which is absent from Debian package contents. TOOLKIT_MIN_VERSION is raised by hand.",
      "managerFilePatterns": ["/^toolkit\\.Dockerfile$/", "/^README\\.md$/"],
      "matchStrings": [
        "ARG TOOLKIT_VERSION=(?<currentValue>\\S+)",
        "reference: ghcr\\.io/inomotech-foss/timescaledb-cnpg/toolkit:(?<currentValue>\\S+)-pg[0-9]+"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "timescale/timescaledb-toolkit",
      "extractVersionTemplate": "^v?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)(?:\\+p[0-9]+)?$"
    }
  ],
  "packageRules": [
    {
      "description": "The base image tag encodes the PostgreSQL major, which PG_MAJOR must match, so major bumps are a deliberate change.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
